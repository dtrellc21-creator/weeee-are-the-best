<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="done_for_last_time.MainPage">

    <!-- R4: Grid Layout with specified rows and columns -->
    <Grid RowDefinitions="Auto,*,Auto,Auto"
          ColumnDefinitions="*,Auto"
          Padding="20" 
          RowSpacing="12" 
          ColumnSpacing="12">

        <!-- R5: Title Label stretching across both columns -->
        <Label Grid.Row="0" 
               Grid.Column="0" 
               Grid.ColumnSpan="2" 
               Text="Daily Gym Workout Log" 
               FontSize="24" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" 
               VerticalOptions="Center" />

        <!-- R2 & R3: Left Column CollectionView -->
        <CollectionView x:Name="ExercisesCollectionView" 
                        Grid.Row="1" 
                        Grid.Column="0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" 
                           FontSize="18" 
                           Padding="5" 
                           VerticalOptions="Center" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- R2 & R3: Right Column CollectionView -->
        <CollectionView x:Name="RepsCollectionView" 
                        Grid.Row="1" 
                        Grid.Column="1">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Label Text="{Binding .}" 
                           FontSize="18" 
                           Padding="5" 
                           HorizontalOptions="End" 
                           VerticalOptions="Center" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- R6: Button to calculate the total reps -->
        <Button Grid.Row="2" 
                Grid.Column="0" 
                Grid.ColumnSpan="2" 
                Text="Calculate Total Reps" 
                Clicked="OnCalculateTotalClicked" />

        <!-- R7: Label to display total -->
        <Label x:Name="TotalDisplayLabel" 
               Grid.Row="3" 
               Grid.Column="0" 
               Grid.ColumnSpan="2" 
               Text="Total Reps: 0" 
               FontSize="20" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

    </Grid>
</ContentPage>